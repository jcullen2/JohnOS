<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jc.os.daily</string>

  <!-- Render the Daily every morning at 6:30, after the 4:00–6:15 producer
       batch window has written the day's queue items. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__OS_ROOT__/engine/render_daily.py</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>__OS_ROOT__</string>
  <key>StandardOutPath</key>
  <string>__OS_ROOT__/engine/schedule/daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>__OS_ROOT__/engine/schedule/daily.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>

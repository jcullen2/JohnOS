<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jc.os.daily-pm</string>

  <!-- Evening edition at 17:00: a delta of items created/changed since the 7:00
       morning render, plus anything that crossed the urgency threshold. Opens
       and emails like the morning job. Writes /daily/<date>-pm.{html,md}. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__OS_ROOT__/engine/render_daily.py</string>
    <string>--since</string>
    <string>07:00</string>
    <string>--open</string>
    <string>--email</string>
    <string>johndcullen2@gmail.com</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>17</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>__OS_ROOT__</string>
  <key>StandardOutPath</key>
  <string>__OS_ROOT__/engine/schedule/daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>__OS_ROOT__/engine/schedule/daily.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
